NODE_ENV=development
PORT=5080
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/subkamyaab?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
OTP_DEV_MODE=true

# Uploaded files (resumes, documents, photos)
UPLOAD_DIR=uploads

# Voice / video calls - from your LiveKit Cloud project (or self-hosted server)
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Push notifications - Firebase console > Project settings > Service accounts >
# Generate new private key. Put the file path (or the JSON itself) here.
FIREBASE_SERVICE_ACCOUNT=

# Payments - Razorpay dashboard > Account & Settings > API keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard > Webhooks: URL https://<api domain>/api/v1/payments/webhook,
# events payment.captured + payment.failed + order.paid; put its secret here.
RAZORPAY_WEBHOOK_SECRET=
# Lets POST /wallet/add-money credit without paying (local testing only).
ALLOW_DIRECT_TOPUP=true
